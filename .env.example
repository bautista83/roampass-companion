# ─────────────────────────────────────────────────────────────────────────────
# Configuracion de Roamle: UN SOLO archivo para todo el proyecto.
# Copialo como .env (en esta misma carpeta raiz) y completa los valores.
# El .env no se sube a git.
#
# Seguridad: el cliente (Vite) solo expone al navegador las variables que empiezan
# con VITE_. Todas las demas (base de datos, JWT, admin) quedan solo en el servidor.
# ─────────────────────────────────────────────────────────────────────────────

# ── Cliente (navegador) ──────────────────────────────────────────────────────

# URL del backend. Vacio = "modo demo local": sin servidor ni base de datos; usuarios y
# partidas se guardan en el navegador (localStorage). Con backend: http://localhost:4000/api
VITE_API_URL=

# API key de Google Maps para jugar LUGAR con Street View (Maps Embed API).
# Vacio = LUGAR usa fotos de lugares conocidos. Ver README > "Street View".
VITE_GOOGLE_MAPS_API_KEY=

# Correo de contacto que muestra la politica de privacidad (/privacy). Publico. Vacio = no se muestra.
VITE_CONTACT_EMAIL=

# App para celulares (docs/specs/mobile-app.md, D16): version minima que acepta el servidor.
# Si la app instalada es mas vieja, pide actualizarla con el enlace a la tienda.
MIN_APP_VERSION=0.0.0
ANDROID_STORE_URL=
IOS_STORE_URL=

# ── Servidor (API + base de datos) ───────────────────────────────────────────

# Conexion a PostgreSQL. Estos valores coinciden con docker-compose.yml.
DATABASE_URL="postgresql://roampass:roampass@localhost:5432/roampass?schema=public"

# Secreto para firmar los tokens de login. Usa un texto largo y aleatorio.
JWT_SECRET="cambia-esto-por-un-secreto-largo-y-aleatorio"

# Puerto de la API y origen permitido (donde corre el cliente). Varios: separados por coma.
PORT=4000
CORS_ORIGIN="http://localhost:5173"

# Usuario ADMIN inicial que crea `npm run db:seed -w server`.
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="cambia-esta-clave"

# ── Correo (confirmación de cuenta y recuperación de contraseña) ────────────

# URL pública de la app: los enlaces de los correos apuntan acá.
# Vacío = se usa CORS_ORIGIN (en desarrollo, http://localhost:5173).
APP_URL=

# Servidor SMTP. Vacío = no se envían correos: el enlace se imprime en la consola
# del servidor (sirve para desarrollo). En producción: Brevo (ver deploy/DEPLOY.md).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Roamle <no-reply@localhost>"

# ── Captcha del registro (Cloudflare Turnstile, opcional) ────────────────────
# Las dos vacías = captcha apagado. Claves de prueba de Cloudflare que siempre aprueban:
#   VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
#   TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
VITE_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Detrás de Cloudflare Tunnel: "true" para limitar intentos por la IP real (CF-Connecting-IP).
TRUST_CLOUDFLARE=false

# Modo online: foto fija de Street View para los espectadores (la pide el servidor). Vacía = usa
# VITE_GOOGLE_MAPS_API_KEY; si esa clave está restringida por dominio, pon aquí otra sin restricción.
GOOGLE_MAPS_API_KEY=
