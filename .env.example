# ─────────────────────────────────────────────────────────────────────────────
# Configuracion de RoamPass: UN SOLO archivo para todo el proyecto.
# Copialo como .env (en esta misma carpeta raiz) y completa los valores.
# El .env no se sube a git.
#
# Seguridad: el cliente (Vite) solo expone al navegador las variables que empiezan
# con VITE_. Todas las demas (base de datos, JWT, admin) quedan solo en el servidor.
# ─────────────────────────────────────────────────────────────────────────────

# ── Cliente (navegador) ──────────────────────────────────────────────────────

# URL del backend. Vacio = "modo demo local": sin servidor ni base de datos; usuarios y
# partidas se guardan en el navegador (localStorage). Con backend: http://localhost:4000/api
VITE_API_URL=

# API key de Google Maps para jugar LUGAR con Street View (Maps Embed API).
# Vacio = LUGAR usa fotos de lugares conocidos. Ver README > "Street View".
VITE_GOOGLE_MAPS_API_KEY=

# ── Servidor (API + base de datos) ───────────────────────────────────────────

# Conexion a PostgreSQL. Estos valores coinciden con docker-compose.yml.
DATABASE_URL="postgresql://roampass:roampass@localhost:5432/roampass?schema=public"

# Secreto para firmar los tokens de login. Usa un texto largo y aleatorio.
JWT_SECRET="cambia-esto-por-un-secreto-largo-y-aleatorio"

# Puerto de la API y origen permitido (donde corre el cliente).
PORT=4000
CORS_ORIGIN="http://localhost:5173"

# Usuario ADMIN inicial que crea `npm run db:seed -w server`.
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="cambia-esta-clave"
