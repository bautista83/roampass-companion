# Variables del build de la app para celulares (docs/specs/mobile-app.md).
# Copiar a .env.mobile (no se sube a git). `npm run mobile:sync -w client` compila con
# `vite build --mode mobile`: estas variables pisan las del .env de desarrollo.

# La app usa siempre el backend real (D2). Debe ser una URL absoluta con https.
VITE_API_URL=https://playroamle.com/api

# Claves publicas (las mismas que la web). Turnstile debe tener app.playroamle.com entre sus
# hostnames; si la clave de Google Maps esta restringida por sitio, sumar https://app.playroamle.com.
VITE_TURNSTILE_SITE_KEY=
VITE_GOOGLE_MAPS_API_KEY=
VITE_CONTACT_EMAIL=
