# .env de PRODUCCION para vm-dev-web. En el servidor: cp deploy/production.env.example .env
# y completa los valores. Nunca lo subas a git.

# Hace que `docker compose ...` en la raiz use el compose de produccion.
COMPOSE_FILE=docker-compose.prod.yml

# Cliente: la URL de la API la fija el build (/api). Aqui solo la clave de Street View (opcional).
VITE_GOOGLE_MAPS_API_KEY=

# Base de datos compartida de la VM: host "postgres" (contenedor en la red dev-net).
# Usa una clave solo con letras y numeros (openssl rand -hex 16) para no romper la URL.
DATABASE_URL="postgresql://roampass:CLAVE_DE_ROAMPASS@postgres:5432/roampass?schema=public"

# Secreto de los tokens de login: openssl rand -hex 32
JWT_SECRET="pega-aqui-un-secreto-largo"

# Origen desde el que se abre la app (mismo origen que la API gracias al Nginx).
CORS_ORIGIN="http://192.168.100.202:8080"

# Admin inicial que crea el seed (cambia la clave despues del primer login).
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="cambia-esta-clave"
