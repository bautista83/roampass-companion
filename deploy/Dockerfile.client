# Cliente de Roamle (React + Vite) servido como estaticos por Nginx. Build context: raiz del repo.
FROM node:24-bookworm-slim AS build
WORKDIR /app

COPY package.json package-lock.json tsconfig.base.json ./
COPY shared ./shared
COPY client ./client
COPY server/package.json ./server/package.json

# --ignore-scripts: evita el `prisma generate` del server, que aqui no hace falta.
RUN npm ci --ignore-scripts

# Las variables VITE_ se "hornean" en el bundle al compilar.
# /api es relativa: el Nginx de la VM manda /api al contenedor de la API (mismo origen, sin CORS).
ARG VITE_API_URL=/api
ARG VITE_GOOGLE_MAPS_API_KEY=
ARG VITE_TURNSTILE_SITE_KEY=
ENV VITE_API_URL=$VITE_API_URL \
    VITE_GOOGLE_MAPS_API_KEY=$VITE_GOOGLE_MAPS_API_KEY \
    VITE_TURNSTILE_SITE_KEY=$VITE_TURNSTILE_SITE_KEY

RUN npm run build -w client

FROM nginx:1.27-alpine
COPY deploy/nginx/spa.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/client/dist /usr/share/nginx/html
EXPOSE 80
