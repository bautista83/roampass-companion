# Firma de la app para Google Play (deploy/MOBILE.md, paso "Clave de subida").
# Copiar como keystore.properties (en esta misma carpeta, client/android) y completar.
# keystore.properties NO se sube a git. Guarda la clave y las contraseñas en un lugar seguro:
# sin ellas no se pueden subir versiones nuevas (se puede pedir a Google que la reemplace, pero tarda).

# Ruta al archivo .jks. Mejor fuera del repositorio; relativa a client/android o absoluta
# (en Windows con barras normales: C:/Users/tu-usuario/claves/roamle-upload.jks).
storeFile=C:/ruta/a/roamle-upload.jks
storePassword=
keyAlias=upload
keyPassword=
