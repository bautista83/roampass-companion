{
  "name": "@roampass/client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "mobile:assets": "node scripts/mobile-assets.mjs && capacitor-assets generate --android --ios --iconBackgroundColor #eaf2e6 --splashBackgroundColor #eaf2e6",
    "mobile:sync": "tsc --noEmit && vite build --mode mobile && cap sync",
    "mobile:android": "npm run mobile:sync && cap open android"
  },
  "dependencies": {
    "@capacitor-community/keep-awake": "^8.0.1",
    "@capacitor/android": "^8.6.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/core": "^8.6.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.6.2",
    "@capacitor/push-notifications": "^8.1.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@roampass/shared": "*",
    "framer-motion": "^12.23.0",
    "i18next": "^25.10.10",
    "leaflet": "^1.9.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-i18next": "^15.7.4",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "^7.9.0",
    "socket.io-client": "^4.8.4",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@capacitor/assets": "^4.0.0",
    "@capacitor/cli": "^8.6.2",
    "@tailwindcss/vite": "^4.1.0",
    "@types/leaflet": "^1.9.20",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "tailwindcss": "^4.1.0",
    "typescript": "~5.9.0",
    "vite": "^7.1.0"
  }
}
