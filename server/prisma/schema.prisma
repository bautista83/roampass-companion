generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  PLAYER
}

/// Estilo visual elegido por el usuario en su perfil (COMIC es el estilo base).
enum UiTheme {
  COMIC
  RETRO
}

enum VictoryMode {
  POINTS
  ROUNDS
}

enum GameStatus {
  /// Sala de espera de una partida online.
  LOBBY
  PLAYING
  FINISHED
}

enum GameKind {
  /// Partida en un solo dispositivo: el cliente es autoritativo y sincroniza el snapshot.
  LOCAL
  /// Partida online multijugador: el servidor es autoritativo (shared/src/online.ts).
  ONLINE
}

enum InviteStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
  EXPIRED
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum CardCategory {
  LOCATION
  FLAG
  CITY
  HISTORY
  PERSONALITY
  TRAVEL_EVENT
}

model User {
  id                     String        @id @default(cuid())
  username               String        @unique
  passwordHash           String
  role                   Role          @default(PLAYER)
  isActive               Boolean       @default(true)
  theme                  UiTheme       @default(COMIC)
  /// Idioma de la interfaz y de los correos (ver shared/src/i18n.ts).
  locale                 String        @default("es")
  /// Correo en minusculas. null en cuentas anteriores al registro con correo o creadas por el admin.
  email                  String?       @unique
  /// null = correo sin confirmar: no puede iniciar sesion (salvo que no tenga correo).
  emailVerifiedAt        DateTime?
  /// Correo nuevo pedido desde Mi perfil, hasta que se confirma con el enlace.
  pendingEmail           String?
  /// Cambia con cada foto nueva: el cliente lo usa para invalidar la cache. null = sin foto.
  photoUpdatedAt         DateTime?
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt
  photo                  UserPhoto?
  emailTokens            EmailToken[]
  invitesSent            GameInvite[]  @relation("InviteFrom")
  invitesReceived        GameInvite[]  @relation("InviteTo")
  hostedGames            GameSession[]
  players                Player[]
  /// Quien lo invito, si la cuenta se creo desde el enlace de una invitacion por correo.
  invitedById            String?
  invitedBy              User?         @relation("InvitedBy", fields: [invitedById], references: [id], onDelete: SetNull)
  invitedUsers           User[]        @relation("InvitedBy")
  emailInvitesSent       EmailInvite[] @relation("EmailInviteFrom")
  emailInvitesRegistered EmailInvite[] @relation("EmailInviteRegistered")
  /// Celulares con la app (notificaciones push, docs/specs/mobile-app.md).
  devices                DeviceToken[]
  /// Tipos de push apagados por el usuario (PushType); por defecto, todos encendidos.
  pushMuted              String[]      @default([])
}

enum DevicePlatform {
  ANDROID
  IOS
}

/// Token de Firebase Cloud Messaging de un celular. Un token pertenece a un solo usuario (MA-02).
model DeviceToken {
  id         String         @id @default(cuid())
  userId     String
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  token      String         @unique
  platform   DevicePlatform
  appVersion String
  createdAt  DateTime       @default(now())
  lastSeenAt DateTime       @default(now())

  @@index([userId])
}

enum EmailTokenPurpose {
  VERIFY_EMAIL
  CHANGE_EMAIL
  RESET_PASSWORD
}

/// Enlace enviado por correo. Solo se guarda el hash SHA-256 del token; es de un solo uso.
model EmailToken {
  id        String            @id @default(cuid())
  userId    String
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose   EmailTokenPurpose
  tokenHash String            @unique
  /// Correo al que se envio (en CHANGE_EMAIL, el correo nuevo).
  email     String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime          @default(now())

  @@index([userId, purpose])
}

/// Foto del pasaporte: WebP 256x256 sin metadatos (la procesa el servidor con sharp).
/// Tabla aparte para no cargar los bytes cada vez que se lee un usuario.
model UserPhoto {
  userId    String   @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  data      Bytes
  mimeType  String
  updatedAt DateTime @updatedAt
}

/// Partida. `state` guarda el snapshot completo del motor (@roampass/shared) para
/// reanudarla tal cual; las columnas planas existen para consultas y estadisticas.
model GameSession {
  id                 String        @id // id generado por el cliente => sincronizacion idempotente
  hostId             String
  host               User          @relation(fields: [hostId], references: [id], onDelete: Cascade)
  victoryMode        VictoryMode
  target             Int
  status             GameStatus    @default(PLAYING)
  currentRound       Int           @default(1)
  currentPlayerIndex Int           @default(0)
  state              Json
  startedAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  finishedAt         DateTime?
  kind               GameKind      @default(LOCAL)
  /// Se incrementa en cada accion aplicada a una partida online (concurrencia optimista).
  version            Int           @default(0)
  players            Player[]
  invites            GameInvite[]
  emailInvites       EmailInvite[]

  @@index([hostId, status])
  @@index([kind, status])
}

/// Invitacion a una partida online (la manda el anfitrion; vence a los 10 minutos).
model GameInvite {
  id           String       @id @default(cuid())
  sessionId    String
  session      GameSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  fromUserId   String
  fromUser     User         @relation("InviteFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUserId     String
  toUser       User         @relation("InviteTo", fields: [toUserId], references: [id], onDelete: Cascade)
  /// Millas iniciales si se suma con la partida empezada.
  initialMiles Int          @default(0)
  status       InviteStatus @default(PENDING)
  createdAt    DateTime     @default(now())
  expiresAt    DateTime
  respondedAt  DateTime?
  /// Correo que escribio el anfitrion, si invito por correo a alguien que ya tenia cuenta: la sala
  /// muestra el correo y no el usuario hasta que acepta (no revela que el correo esta registrado).
  viaEmail     String?

  @@index([toUserId, status])
  @@index([sessionId, status])
}

enum EmailInviteKind {
  FRIEND
  GAME
}

enum EmailInviteStatus {
  PENDING
  REGISTERED
  ALREADY_MEMBER
  CLOSED
  BLOCKED
  EXPIRED
}

/// Invitacion por correo (ver docs/specs/email-invitations.md). Solo se guarda el hash del token.
model EmailInvite {
  id               String            @id @default(cuid())
  kind             EmailInviteKind
  fromUserId       String?
  fromUser         User?             @relation("EmailInviteFrom", fields: [fromUserId], references: [id], onDelete: SetNull)
  /// Copia del usuario que invito, para el admin si se elimina la cuenta.
  fromUsername     String
  /// Correo en minusculas.
  email            String
  /// Partida online (GAME). Si se elimina la sala queda en null y vale como invitacion de amigo.
  sessionId        String?
  session          GameSession?      @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  initialMiles     Int               @default(0)
  tokenHash        String            @unique
  status           EmailInviteStatus @default(PENDING)
  createdAt        DateTime          @default(now())
  expiresAt        DateTime
  registeredUserId String?
  registeredUser   User?             @relation("EmailInviteRegistered", fields: [registeredUserId], references: [id], onDelete: SetNull)
  registeredAt     DateTime?

  @@index([fromUserId, createdAt])
  @@index([email, createdAt])
  @@index([status])
}

/// Correos que pidieron no recibir invitaciones (se guarda solo el hash SHA-256 del correo).
model EmailOptOut {
  emailHash String   @id
  createdAt DateTime @default(now())
}

model Player {
  id        String      @id @default(cuid())
  sessionId String
  session   GameSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  /// Usuario registrado que juega con este peon (opcional: los invitados no tienen cuenta).
  userId    String?
  user      User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  turnOrder Int
  name      String
  color     String
  avatar    String
  score     Int         @default(0)
  isWinner  Boolean     @default(false)
  stats     Json?
  /// Partida online oculta del panel de este jugador (sigue contando en sus estadisticas).
  hiddenAt  DateTime?

  @@unique([sessionId, turnOrder])
  @@index([userId])
}

/// Carta del mazo. Los campos aplican segun la categoria:
/// - LOCATION: latitude, longitude, answerLabel; imageUrl solo en las de foto (sin imageUrl = Street View)
/// - FLAG: countryCode, options, correctAnswer
/// - CITY / HISTORY / PERSONALITY: options, correctAnswer, imageUrl opcional
/// - TRAVEL_EVENT: prompt (titulo), description, icon, points
/// `difficulty` aplica a todas salvo TRAVEL_EVENT (suma un bonus si la respuesta da millas: +0 / +500 / +1.000).
/// Las banderas y capitales de casi todos los paises no se guardan aqui: el cliente las genera
/// desde shared/data/countries.json.
model CardQuestion {
  id            String       @id // slug estable, ej. "flag-ar"
  category      CardCategory
  difficulty    Difficulty?
  prompt        String
  description   String?
  icon          String?
  imageUrl      String?
  countryCode   String?
  options       String[]
  correctAnswer String?
  points        Int?
  latitude      Float?
  longitude     Float?
  answerLabel   String?
  funFact       String?
  credit        Json?
  /// Traducciones opcionales: { "en": { prompt, options, funFact, ... } } (ver CardTranslation).
  translations  Json?
  isActive      Boolean      @default(true)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([category, difficulty, isActive])
}
